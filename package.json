{
  "name": "slidetake",
  "version": "0.1.0",
  "description": "Markdown to finished video: a spatial deck that records itself, take by take",
  "license": "Apache-2.0",
  "author": "Sakthi Priyan H",
  "repository": "github:sakthipriyan/slidetake",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && (node build.mjs --watch & wrangler dev --port 8787 --ip 127.0.0.1)",
    "watch": "node build.mjs --watch",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "wrangler": "^4.152.0"
  }
}
