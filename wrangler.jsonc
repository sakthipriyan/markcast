{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slidetake",
  "compatibility_date": "2026-10-25",

  // Assets-only Worker (same pattern as xfina-labs and xsteer): no script, so requests are served
  // straight from the edge with no Worker invocation and no per-request cost.
  "assets": {
    "directory": "./dist",
    // Any path serves the app, so it can read links like /gh/owner/repo/deck.md itself.
    "not_found_handling": "single-page-application"
  },

  // www gets its own DNS record and certificate here; a Cloudflare redirect rule then sends it to
  // slidetake.com (an assets-only Worker can't redirect by itself).
  "routes": [
    { "pattern": "slidetake.com", "custom_domain": true },
    { "pattern": "www.slidetake.com", "custom_domain": true }
  ]
}
